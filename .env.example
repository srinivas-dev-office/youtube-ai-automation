# Google Gemini API Key (Story Generation, Screenplays & Image Generation)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Third-Party AI Video Engine Providers (Optional)
# If unconfigured or keys are omitted, ToonCraft automatically falls back to 
# studio-grade 2.5D FFmpeg Organic Cinematic Rendering with zero downtime.

# RunwayML Gen-2 / Gen-3 Alpha API Key (https://runwayml.com/)
RUNWAY_API_KEY=your_runway_api_key_here

# Pika 1.0 / 2.0 API Key (https://pika.art/)
PIKA_API_KEY=your_pika_api_key_here

# Stability AI Stable Video Diffusion (SVD / SVD-XT) API Key (https://stability.ai/)
STABILITY_API_KEY=your_stability_api_key_here

# Server & Rendering Settings
PORT=3000

# Optional: Custom path to FFmpeg executable if not in system PATH
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
